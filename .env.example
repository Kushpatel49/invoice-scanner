# Copy to .env and fill in. .env is git-ignored - never commit real keys.

# OpenRouter key (https://openrouter.ai/settings/keys). Without it the scanner
# falls back to a local Ollama model.
OPENROUTER_API_KEY=

# Optional overrides (defaults shown)
# SCANNER_BACKEND=openrouter          # or: ollama
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl
# OLLAMA_MODEL=qwen3-vl:8b-instruct
# OLLAMA_URL=http://localhost:11434/api/chat

